<?xml version='1.0'?>
<sdf version="1.7">
    <model name="asphalt_ground_plane">
        <pose>0 0 0 0 0 0</pose>
        <self_collide>false</self_collide>
        <!-- BASE_LINK FRAME -->
        <link name="ground_base">
            <pose>0 0 0 0 0 0</pose>
            <collision name="ground_base_collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <plane>
                        <normal>0.0 0.0 1</normal>
                        <size>20 20</size>
                    </plane>
                </geometry>
            </collision>
            <visual name="ground_base_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/elkapod_asphalt_ground_plane.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <static>1</static>
    </model>
</sdf>
